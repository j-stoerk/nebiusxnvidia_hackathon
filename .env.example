# No configuration is needed for optimization or local computed summaries.
# Optional key-free self-hosted Nemotron, on the SAME host (for example a Nebius GPU DevPod).
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
# Example: http://127.0.0.1:8001/v1 and nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16

# Optional Nebius Token Factory. Credentials stay server-side and out of Git.
# Leave false for no paid inference. Enable only after reviewing account billing.
CLOUD_INFERENCE_ENABLED=false
CLOUD_INFERENCE_BUDGET_USD=0.05
CLOUD_INFERENCE_MAX_REQUESTS=12
CLOUD_INFERENCE_MAX_TOKENS=1024
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Hugging Face routing is retained for development, but the credit guard rejects
# unpriced providers/models. Only the listed Nebius model has a verified allowance.
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
HF_PROVIDER=featherless-ai

# Optional acquisition only.
ACN_API_TOKEN=
