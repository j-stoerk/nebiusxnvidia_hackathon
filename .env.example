# No configuration is needed for optimization or local computed summaries.
# Optional key-free self-hosted Nemotron, on the SAME host (for example a Nebius GPU DevPod).
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
# Example: http://127.0.0.1:8001/v1 and nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16

# Optional Nebius Token Factory. Credentials stay server-side and out of Git.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional Hugging Face provider; does not by itself establish Nebius execution.
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
HF_PROVIDER=featherless-ai

# Optional acquisition only.
ACN_API_TOKEN=
